<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PomoDock.Web</RootNamespace>
    <!-- Month and weekday names come from Strings.Culture, so the browser needs real culture data. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- The Core seals the agent key with Windows DPAPI; the web never calls that path. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.31" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.31" PrivateAssets="all" />
  </ItemGroup>
  <!-- The same Core the desktop runs: timer, books, parsers, sounds and every word on screen. -->
  <ItemGroup><ProjectReference Include="..\PomoDock.Core\PomoDock.Core.csproj" /></ItemGroup>
  <!-- The dumbbell programs and the exercise catalog are plain C#; the web compiles the desktop's files as they are. -->
  <ItemGroup>
    <Compile Include="..\PomoDock.App\WorkoutPrograms.cs" Link="Shared\WorkoutPrograms.cs" />
    <Compile Include="..\PomoDock.App\WorkoutCatalog.cs" Link="Shared\WorkoutCatalog.cs" />
    <EmbeddedResource Include="..\PomoDock.App\Assets\Workout\exercises.json" Link="Shared\exercises.json" />
  </ItemGroup>
</Project>
